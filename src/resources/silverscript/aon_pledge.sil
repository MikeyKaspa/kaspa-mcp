pragma silverscript ^0.1.0;

// All-or-nothing per-backer pledge. Sibling inputs must share this redeem
// template with only backerPkh varying (prefix/suffix via scriptSig substr).
// redeemLen=1088 backerOff=916 — must match silverc output.
// fee is a MINIMUM — output may pay more to cover compute mass.
contract AoNPledge(
    byte[32] ownerPkh,
    byte[32] backerPkh,
    byte[32] campaignTag,
    int goalSompi,
    temporal deadline
) {
    entry claim(pubkey pk, sig s) {
        require(blake2b(byte[](pk)) == ownerPkh);
        require(checkSig(s, pk));
        require(campaignTag == campaignTag);

        int active = this.activeInputIndex;
        int activeLen = OpTxInputScriptSigLen(active);
        int redeemLen = 1088;
        int backerOff = 916;
        int backerEnd = 948;
        require(activeLen >= redeemLen);
        byte[] pref = OpTxInputScriptSigSubstr(active, activeLen - redeemLen, activeLen - redeemLen + backerOff);
        byte[] suf = OpTxInputScriptSigSubstr(active, activeLen - redeemLen + backerEnd, activeLen);

        int total = 0;
        for (i, 0, tx.inputs.length, 8) {
            require(tx.inputs[i].scriptPubKey.length == 37);
            int slen = OpTxInputScriptSigLen(i);
            require(slen == activeLen);
            require(OpTxInputScriptSigSubstr(i, slen - redeemLen, slen - redeemLen + backerOff) == pref);
            require(OpTxInputScriptSigSubstr(i, slen - redeemLen + backerEnd, slen) == suf);
            total = total + tx.inputs[i].value;
        }
        require(total >= goalSompi);
        byte[36] toOwner = new ScriptPubKeyP2PK(pk);
        require(tx.outputs[0].scriptPubKey == byte[](toOwner));
        int minFee = 300000;
        require(tx.outputs[0].value <= total - minFee);
        require(tx.outputs[0].value > 0);
        require(tx.outputs.length == 1);
    }

    entry reclaim(pubkey pk, sig s) {
        require(blake2b(byte[](pk)) == backerPkh);
        require(checkSig(s, pk));
        require(tx.time >= deadline);
        require(campaignTag == campaignTag);
        byte[36] toBacker = new ScriptPubKeyP2PK(pk);
        require(tx.outputs[0].scriptPubKey == byte[](toBacker));
        int minFee = 300000;
        int val = tx.inputs[this.activeInputIndex].value;
        require(tx.outputs[0].value <= val - minFee);
        require(tx.outputs[0].value > 0);
        require(tx.outputs.length == 1);
    }
}
