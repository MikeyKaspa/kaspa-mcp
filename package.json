{
  "name": "kaspa-mcp",
  "version": "0.2.0",
  "description": "Public open-source MCP connector for Kaspa L1 SilverScript (primary) and Kasplex/Igra EVM (secondary). Non-custodial, $0 public RPCs.",
  "type": "module",
  "license": "MIT",
  "author": "Kaspa community",
  "keywords": [
    "kaspa",
    "silverscript",
    "covenants",
    "toccata",
    "kasplex",
    "igra",
    "mcp",
    "smart-contracts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MikeyKaspa/kaspa-mcp"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js"
  },
  "bin": {
    "kaspa-mcp": "./dist/node-server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/node-server.ts",
    "dev": "tsx watch src/node-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:testnet": "tsx scripts/e2e-testnet.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e:l1-tn10": "tsx scripts/e2e-l1-tn10.mjs",
    "test:l1": "vitest run tests/l1-silverscript.test.ts",
    "e2e:l1-thorough": "tsx scripts/e2e-l1-thorough.mjs",
    "e2e:spending-wallet": "npm run build && SILVERC_PATH=${SILVERC_PATH:-/workspace/silverscript-tools/silverc} node scripts/e2e-spending-wallet.mjs",
    "e2e:worker-selfhost": "node scripts/e2e-worker-selfhost.mjs",
    "selfhost:setup": "node scripts/selfhost-setup.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "bech32": "^2.0.0",
    "ethers": "^6.17.0",
    "kaspa": "file:./vendor/kaspa",
    "solc": "^0.8.28",
    "uqr": "^0.1.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/node": "^24.0.0",
    "playwright": "^1.48.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  },
  "homepage": "https://github.com/MikeyKaspa/kaspa-mcp"
}
